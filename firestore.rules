rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /publicCatalog/mala-mia {
      allow get: if true;
    }
    match /productImages/{imageId} {
      allow get: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
